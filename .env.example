# Public deployment values, written to .env.local by `bunx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Keep RESEND_API_KEY, SENDER_EMAIL, SENDER_NAME, SITE_URL,
# AI_KEY_ENCRYPTION_SECRET, TAVILY_API_KEY, AGENTMAIL_API_KEY,
# AGENTMAIL_INBOX_ID, and AGENTMAIL_WEBHOOK_SECRET in Convex deployment
# environment variables. Do not add them to this file or .env.local.
# Users' AI provider keys are saved in the app, under Settings.
