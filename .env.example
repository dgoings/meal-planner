# Public deployment values used by Next.js and Convex Auth.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# Keep RESEND_API_KEY, SENDER_EMAIL, SENDER_NAME, SITE_URL, ANTHROPIC_API_KEY,
# RECIPE_AGENT_MODEL, TAVILY_API_KEY, AGENTMAIL_API_KEY, AGENTMAIL_INBOX_ID,
# and AGENTMAIL_WEBHOOK_SECRET in Convex deployment environment variables.
# Do not add them to this file or .env.local.
